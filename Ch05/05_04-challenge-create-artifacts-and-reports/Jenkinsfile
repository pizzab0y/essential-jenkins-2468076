pipeline {
    agent any
    tools {
      maven 'Maven-3.8.4'
    }
    stages {
        // stage('Source') {
        //     steps {
        //         git branch: 'main',
        //             changelog: false,
        //             poll: false,
        //             url: 'https://github.com/LinkedInLearning/essential-jenkins-2468076.git'
        //     }
        // }
        stage('Clean') {
            steps {
                dir("${env.WORKSPACE}/Ch05/05_04-challenge-create-artifacts-and-reports"){
                    echo "Cleaning the workspace..."
                    // Uncomment the following line after Maven is configured as a global tool
                    script {
                        def mavenHome = tool 'maven-3.8.4'
                        withEnv(["DIAG_MAVEN_HOME=${mavenHome}"]) {
                            sh '''
                                printf 'Maven home: %s\\nPATH: %s\\n' "$DIAG_MAVEN_HOME" "$PATH"
                                ls -l "$DIAG_MAVEN_HOME/bin/mvn" || true
                                command -v mvn || true
                            '''
                        }
                    }
                    sh 'mvn clean'
                    sh 'mvn --version'
                }
            }
        }
        stage('Test') {
            steps {
                dir("${env.WORKSPACE}/Ch05/05_04-challenge-create-artifacts-and-reports"){
                    echo "Running tests..."
                    // Uncomment the following line after Maven is configured as a global tool
                    sh 'mvn test'
                    sh 'ls'
                    
                }
            }
        }
        stage('Package') {
            steps {
                dir("${env.WORKSPACE}/Ch05/05_04-challenge-create-artifacts-and-reports"){
                    echo "Creating the JAR file..."
                    // Uncomment the following line after Maven is configured as a global tool
                    sh 'mvn package -DskipTests'
                    sh 'ls'
                }
            }
        }
    }
    post {
        always {
            echo "Collecting jUnit test results..."
            // junit allowEmptyResults: true, testResults: '**/pytest_junit.xml'

            // junit allowEmptyResults: true, testResults: '**/pylint_junit.xml'
            
            echo "Archiving the JAR file..."
            // Add artifact archiving here...
        }
    }
}
